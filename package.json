{
  "name": "ziphay-ai",
  "version": "1.0.0",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "electron .",
    "desktop:register": "node desktop/context-menu.js",
    "desktop:unregister": "node desktop/context-menu.js --unregister",
    "desktop:build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.ziphay.ai.desktop",
    "productName": "Ziphay AI",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "desktop/**/*",
      "frontend/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "frontend/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ziphay AI",
      "uninstallDisplayName": "Ziphay AI",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "puppeteer": "^25.3.0",
    "vite": "^5.0.0"
  }
}
